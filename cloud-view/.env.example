# Copy to .env before building. NEVER commit .env — this repo is PUBLIC.
# Anon (publishable) key: Supabase dashboard -> em-grant project -> Settings -> API Keys
VITE_SUPABASE_ANON_KEY=paste_anon_key_here
# View token: must match VIEW_TOKEN in the grant-view-api edge function
VITE_VIEW_TOKEN=paste_view_token_here
# Optional override of the edge function base URL
# VITE_API_BASE=https://idebrliatulbriuitmuy.supabase.co/functions/v1/grant-view-api
